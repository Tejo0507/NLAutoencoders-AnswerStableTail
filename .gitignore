# Benchmarks are staged by the `data` stage, not tracked.
data/raw/
data/processed/

# Run artefacts. Every one is reproducible from `scripts/run_pipeline.py` plus
# the committed config, and a partial run's tables would read like results.
runs/

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# CI by-products, if the workflow's steps are run locally
pytest-report.xml
requirements.ci.txt

# Microsoft Word lock files
~$*

# Local editor, assistant and OS files
.claude/
CLAUDE.md
.vscode/
.idea/
Thumbs.db
.DS_Store

# Derived artefacts: the .docx is tracked, intermediate renders are not.
*.pdf
output/**/*.zip

# Working documents kept locally, not published: session notes and the review
# submissions. PROJECT_PLAN.md (the pre-registration) and docs/ (the decision
# record, status, checklist and audit) are tracked again from 2026-10-17 (D7):
# a reproducibility record that exists only on one disk is not one.
SESSION_HANDOFF.md
Project_Review_*
